# Shared env file for the skill pack. Copy to ~/.claude/skills/.env and fill in only what you use.
# Load before running scripts:  set -a; source ~/.claude/skills/.env; set +a
# Each skill's own .env.example lists just the variables that skill reads.
# Wrap any value that contains spaces in double quotes, e.g. COMPANY_STREET="123 Main St".


# Folder holding index.jsonl (the library). Used by: ad-library
AD_LIBRARY_DIR=
# Optional: extra scrape globs for raw_scan.py. Used by: ad-library
AD_LIBRARY_EXTRA_SCRAPES=
# Your markets in priority order for fit_score, e.g. GB,IE,US. Used by: ad-library
AD_LIBRARY_MARKETS=
# Optional: base URL if you serve the media folder. Used by: ad-library
AD_LIBRARY_MEDIA_BASE=
# Optional: your own sync command, run after a passing audit. Used by: ad-library
AD_LIBRARY_POST_CMD=

# Optional --summarize and --variants passes. Used by: youtube-outliers
ANTHROPIC_API_KEY=

# Apify API token: runs the Meta Ads Library and YouTube transcript scrapers (pay per use). Used by: ad-library, static-ad-factory, video-ad-swipe-page, youtube-outliers
APIFY_TOKEN=
# Optional Apify actor for the transcript fallback (default karamelo/youtube-transcripts). Used by: youtube-outliers
APIFY_TRANSCRIPT_ACTOR=

# Optional company phone enrichment. Used by: cold-email-starter-kit
BLITZ_API_KEY=
# Optional Blitz base URL override. Used by: cold-email-starter-kit
BLITZ_BASE_URL=

# Older name, also accepted.. Used by: video-ad-swipe-page
CHROME_BIN=
# Optional: path to Chrome/Chromium if not auto-detected. Used by: gads-audit, ghl-funnel-build, ghl-survey-qc, video-ad-swipe-page
CHROME_PATH=

# Your business address line for the CAN-SPAM footer (used in copy, not by scripts). Used by: cold-email-starter-kit
COMPANY_CITY=
# Your business address line for the CAN-SPAM footer (used in copy, not by scripts). Used by: cold-email-starter-kit
COMPANY_COUNTRY=
# Your business address line for the CAN-SPAM footer (used in copy, not by scripts). Used by: cold-email-starter-kit
COMPANY_NAME=
# Your business address line for the CAN-SPAM footer (used in copy, not by scripts). Used by: cold-email-starter-kit
COMPANY_STATE=
# Your business address line for the CAN-SPAM footer (used in copy, not by scripts). Used by: cold-email-starter-kit
COMPANY_STREET=
# Your business address line for the CAN-SPAM footer (used in copy, not by scripts). Used by: cold-email-starter-kit
COMPANY_ZIP=

# DataForSEO API login. Used by: ai-visibility-report, gads-audit
DATAFORSEO_LOGIN=
# DataForSEO API password (not the website login password). Used by: ai-visibility-report, gads-audit
DATAFORSEO_PASSWORD=

# Optional reply-to address. Used by: cold-email-starter-kit
DEFAULT_REPLY_TO_EMAIL=

# Optional: folder with DejaVuSans*.ttf if not in a system font folder. Used by: ai-visibility-report
DEJAVU_FONT_DIR=

# Optional: path of the per-call cost ledger. Used by: ai-visibility-report
DFS_LEDGER=
# Optional: label grouping one run's cost ledger lines. Used by: ai-visibility-report
DFS_RUN_ID=

# Domain search, purchase and nameserver switch. Used by: cold-email-starter-kit
DYNADOT_API_KEY=

# Reads your Fathom meetings and transcripts. Used by: ad-snippet-miner
FATHOM_API_KEY=

# Optional. Extra iframe host(s) for fold.mjs on white-label accounts. Used by: ghl-survey-qc
FOLD_IFRAME_HOSTS=

# Optional: name shown in the "who" column and the email greeting (default "PPC manager").. Used by: gads-audit
GADS_AUDIT_OWNER=
# Optional: name that signs the draft email.. Used by: gads-audit
GADS_AUDIT_SENDER=

# GoHighLevel Private Integration token for one sub-account (scopes listed in each skill SETUP.md). Used by: front-desk-sales-kit, ghl-account-audit, ghl-funnel-backend, ghl-funnel-build, ghl-survey-qc, lp-webhook-tracking, meta-ads-analyst, setter-call-audit
GHL_API_KEY=
# GoHighLevel sub-account (location) id. Used by: front-desk-sales-kit, ghl-account-audit, ghl-funnel-backend, ghl-funnel-build, ghl-survey-qc, lp-webhook-tracking, meta-ads-analyst, setter-call-audit
GHL_LOCATION_ID=
# Optional pipeline to audit. Used by: meta-ads-analyst
GHL_PIPELINE_ID=
# The workflow's inbound webhook URL. Used by: lp-webhook-tracking
GHL_WEBHOOK_URL=
# Optional. White-label link domain that serves your widgets. Used by: ghl-survey-qc
GHL_WIDGET_HOST=

# Optional: API version override if the default has been sunset (e.g. v26).. Used by: gads-common
GOOGLE_ADS_API_VERSION=
# OAuth client id (shared). Used by: gads-audit, gads-common
GOOGLE_ADS_CLIENT_ID=
# OAuth client secret (shared). Used by: gads-audit, gads-common
GOOGLE_ADS_CLIENT_SECRET=
# Optional default client account id, 10 digits, no dashes.. Used by: gads-audit, gads-common
GOOGLE_ADS_CUSTOMER_ID=
# API developer token (shared with gads-common). Used by: gads-audit, gads-common
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager account id, no dashes (shared). Used by: gads-audit, gads-common
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Refresh token (shared). Used by: gads-audit, gads-common
GOOGLE_ADS_REFRESH_TOKEN=
# Path to Google OAuth desktop client JSON (Sheets input only). Used by: design-website
GOOGLE_OAUTH_CLIENT_FILE=
# Path where the Google login token is saved (Sheets input only). Used by: design-website
GOOGLE_TOKEN_FILE=

# Create campaigns, add leads, pull analytics (if sending with Instantly). Used by: cold-email-starter-kit
INSTANTLY_API_KEY=

# Optional. String every test email contains so the workflow's Real-enquiry branch skips client alerts (default +lptest). Used by: lp-webhook-tracking
LP_TEST_MARKER=

# Meta Marketing API token, read-only (ads_read). Used by: meta-ads-analyst, meta-launch-audit
META_ACCESS_TOKEN=
# Ad account to pull (live mode). Used by: meta-ads-analyst, meta-launch-audit
META_AD_ACCOUNT_ID=
# Optional campaign pin. Used by: meta-ads-analyst
META_CAMPAIGN_ID=
# Optional Graph API version override (default v21.0). Used by: meta-ads-analyst, meta-launch-audit
META_GRAPH_VERSION=

# Optional: override the Claude CLI command used for the mining pass (default: claude).. Used by: ad-snippet-miner
MINER_CLAUDE_CMD=
# Default config JSON path when --config is not passed. Used by: ad-snippet-miner
MINER_CONFIG=
# Set to 1 so the cron run also posts to Slack. Used by: ad-snippet-miner (optional)
MINER_SLACK=
# Timezone for the Monday-morning cron gate (default Europe/London). Used by: ad-snippet-miner
MINER_TZ=
# One folder for digests + ledger.db, shared by interactive and cron runs (keep outside ~/.claude/skills/). Used by: ad-snippet-miner
MINER_WORKDIR=

# Optional: Netlify team to create the site in. Used by: video-ad-swipe-page
NETLIFY_ACCOUNT_SLUG=
# Optional: publish the page with scripts/deploy.sh. Used by: video-ad-swipe-page
NETLIFY_AUTH_TOKEN=

# Optional: path to Node 22+ if `node` on PATH is older (module 3 needs the built-in WebSocket).. Used by: gads-audit
NODE_BIN=

# OpenAI API key: Whisper transcription, image generation for static ads (optional in most skills). Used by: front-desk-sales-kit, meta-launch-audit, setter-call-audit, static-ad-factory
OPENAI_API_KEY=

# Optional AI company analysis (gpt-4o-mini). Used by: cold-email-starter-kit
OPENROUTER_API_KEY=

# Optional Anthropic model id for --summarize / --variants (default claude-sonnet-4-5). Used by: youtube-outliers
OUTLIERS_MODEL=

# Lead search and export (credits). Used by: cold-email-starter-kit
PROSPEO_API_KEY=

# Optional PageSpeed Insights key for field data. Used by: gads-audit
PSI_API_KEY=

# Optional LinkedIn profile and news enrichment. Used by: cold-email-starter-kit
RAPIDAPI_KEY=

# Local part of inbox 1 per domain. Used by: cold-email-starter-kit
SENDER_EMAIL_PREFIX_1=
# Local part of inbox 2 per domain. Used by: cold-email-starter-kit
SENDER_EMAIL_PREFIX_2=
# Persona first name on the inboxes. Used by: cold-email-starter-kit
SENDER_FIRST_NAME=
# Persona last name on the inboxes. Used by: cold-email-starter-kit
SENDER_LAST_NAME=

# Optional: Slack bot token to post summaries (scope chat:write). Used by: ad-library, ad-snippet-miner, meta-ads-analyst, setter-call-audit
SLACK_BOT_TOKEN=
# Optional: Slack channel to post summaries to. Used by: ad-library, ad-snippet-miner, meta-ads-analyst, setter-call-audit
SLACK_CHANNEL_ID=

# Create campaigns, add leads, pull analytics (if sending with Smartlead). Used by: cold-email-starter-kit, email-deliverability-audit
SMARTLEAD_API_KEY=

# Optional: full path to the sqlite ledger (default: <MINER_WORKDIR or --out>/ledger.db). Usually leave blank and set MINER_WORKDIR.. Used by: ad-snippet-miner
SNIPPET_LEDGER=

# Optional service_role key for --supabase. Used by: gads-audit
SUPABASE_SERVICE_KEY=
# Optional, only for --supabase history tables. Used by: gads-audit
SUPABASE_URL=

# Optional: where work dirs are created. Used by: video-ad-swipe-page
SWIPE_OUTPUT_DIR=

# Optional source with pre-computed outlier ratios (paid credits). Used by: youtube-outliers
TUBELAB_API_KEY=

# Unsplash API access key for real stock photos (optional). Used by: design-website
UNSPLASH_ACCESS_KEY=

# Search and video stats via YouTube Data API v3. Used by: youtube-outliers
YOUTUBE_API_KEY=

# Connect domains, create and export sending inboxes. Used by: cold-email-starter-kit
ZAPMAIL_API_KEY=

# Data and reporting skills
GA4_SERVICE_ACCOUNT_JSON=
CLARITY_API_TOKEN=
GHL_PRIVATE_TOKEN=
SLACK_WEBHOOK_URL=
GHL_TOKEN=YOUR_GHL_PRIVATE_INTEGRATION_TOKEN

# tech-health-check
CLICKUP_API_TOKEN=
GHL_AGENCY_TOKEN=
# one per client, names set in tech-health-check/config.yaml
GHL_TOKEN_EXAMPLE=
