# front-desk-sales-kit: add these to ~/.claude/skills/.env (shared by all skills in the pack)
# Only needed for Step 1 (mining call recordings). Rendering the kit needs no keys.

# GoHighLevel Private Integration token for the sub-account (read-only scopes, see SETUP.md)
GHL_API_KEY=
# GoHighLevel sub-account (location) id
GHL_LOCATION_ID=

# Optional: only if you transcribe with --engine api (sends audio to OpenAI)
OPENAI_API_KEY=
