# Apify API token. Used by scripts/01_discover.py to run the Meta Ads Library scraper actor (paid per ad).
APIFY_TOKEN=
# Optional: Netlify personal access token. Only used by scripts/deploy.sh if you choose to publish the page.
NETLIFY_AUTH_TOKEN=
# Optional: Netlify team slug, only needed if the CLI asks which team to create the site in.
NETLIFY_ACCOUNT_SLUG=
# Optional: path to Chrome/Chromium for scripts/qc_page.mjs if it is not in a standard location.
CHROME_PATH=
# Older name, also accepted.
CHROME_BIN=
# Optional: where work dirs are created (default ./video-ad-swipe-page-output under the current directory).
SWIPE_OUTPUT_DIR=
