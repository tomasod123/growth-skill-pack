# GoHighLevel Private Integration token for the sub-account (read-only View scopes only; all fixes are done by hand in the UI).
# Sub-account Settings > Private Integrations > Create new Integration. Copy the pit- token when shown (once).
GHL_API_KEY=
# Sub-account id: Settings > Business Profile (Location ID), or the id after /location/ in the app URL.
GHL_LOCATION_ID=
