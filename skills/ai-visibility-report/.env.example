# ai-visibility-report: add these to ~/.claude/skills/.env (shared by all skills in the pack)

# DataForSEO API login (the email-style login shown in the DataForSEO dashboard > API Access)
DATAFORSEO_LOGIN=
# DataForSEO API password (dashboard > API Access; this is NOT your website login password)
DATAFORSEO_PASSWORD=

# Optional: folder holding DejaVuSans.ttf / -Bold / -Oblique if they are not in a system font folder
DEJAVU_FONT_DIR=
# Optional: label that groups the cost ledger lines of one run (default: today's date)
DFS_RUN_ID=
# Optional: where the per-call cost ledger is written (default ./ai-visibility-report-output/dfs-cost-ledger.jsonl)
DFS_LEDGER=
