# Meta Marketing API token (read-only system user is enough: ads_read). Used by scripts/meta_audit.py.
META_ACCESS_TOKEN=
# Ad account id, digits only or act_XXXXXXXXXX. Passed as --act.
META_AD_ACCOUNT_ID=
# Optional: Graph API version, e.g. v22.0. Empty = v21.0. Set it when Meta retires the default.
META_GRAPH_VERSION=
# Optional: OpenAI key for Whisper transcription of video ads in step 4.
OPENAI_API_KEY=
