# setter-call-audit: add these to ~/.claude/skills/.env (shared by all skills in the pack)

# GoHighLevel Private Integration token for the sub-account (read-only scopes, see SETUP.md)
GHL_API_KEY=
# GoHighLevel sub-account (location) id
GHL_LOCATION_ID=

# Optional: only if you use --engine api for transcription (sends audio to OpenAI)
OPENAI_API_KEY=
# Optional: post a summary to Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
