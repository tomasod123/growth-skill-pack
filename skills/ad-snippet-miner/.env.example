# Fathom API key (required). Fathom > Settings > API Access (Integrations) > Generate API key.
FATHOM_API_KEY=
# Optional: Slack bot token (xoxb-...) to post the digest. Leave blank to only write local files.
SLACK_BOT_TOKEN=
# Optional: where to post. A user id (U...) for a DM, or a private channel id (C... / G...).
SLACK_CHANNEL_ID=
# Optional: override the Claude CLI command used for the mining pass (default: claude).
MINER_CLAUDE_CMD=
# Optional: full path to the sqlite ledger (default: <MINER_WORKDIR or --out>/ledger.db). Usually leave blank and set MINER_WORKDIR.
SNIPPET_LEDGER=
# Optional: timezone for the weekly Monday 08:00-10:59 gate in scripts/run_weekly.sh (IANA name, default Europe/London), e.g. America/New_York.
MINER_TZ=
# Optional but recommended: ONE folder for digests + ledger.db, shared by interactive and cron runs. Keep it OUTSIDE ~/.claude/skills/ so reinstalling the skill never wipes the ledger, e.g. $HOME/ad-snippet-miner-output
MINER_WORKDIR=
# Optional: path to your config JSON, used when --config is not passed, e.g. $HOME/ad-snippet-miner-output/ad-snippet-miner-config.json
MINER_CONFIG=
# Optional: set to 1 so the cron wrapper also posts the digest to Slack (needs SLACK_BOT_TOKEN + SLACK_CHANNEL_ID).
MINER_SLACK=
