# YouTube Data API v3 key (recommended source). Google Cloud Console > APIs & Services > Library > "YouTube Data API v3" > Enable; then Credentials > Create credentials > API key.
YOUTUBE_API_KEY=
# Optional: Apify token, fallback for transcripts when youtube-transcript-api is blocked. Apify Console > Settings > API & Integrations > Personal API tokens.
APIFY_TOKEN=
# Optional: Apify transcript actor id (default karamelo/youtube-transcripts).
APIFY_TRANSCRIPT_ACTOR=
# Optional: TubeLab API key for --source tubelab (pre-computed outlier ratios, paid credits). tubelab.net > account > API.
TUBELAB_API_KEY=
# Optional: Anthropic API key for --summarize and --variants. console.anthropic.com > Settings > API keys.
ANTHROPIC_API_KEY=
# Optional: model for --summarize / --variants (default claude-sonnet-4-5).
OUTLIERS_MODEL=
