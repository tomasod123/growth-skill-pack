# Optional. Only for the read-only GHL API checks in SKILL.md (funnel list, calendar redirect).
# The two scripts (block_lint.py, qc_sweep.mjs) need no keys.

# GHL Private Integration token (sub-account level). calendars.write is optional; Claude asks before any write
GHL_API_KEY=
# GHL sub-account (location) id
GHL_LOCATION_ID=
# Optional: full path to Chrome/Chromium if qc_sweep.mjs cannot find it (CHROME_BIN also accepted)
CHROME_PATH=
