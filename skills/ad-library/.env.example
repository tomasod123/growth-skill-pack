# Where the library lives (folder holding index.jsonl). Default: ./ad-library-data under the current directory.
AD_LIBRARY_DIR=
# Your markets in priority order, ISO codes, comma-separated (first = home market, scores highest in fit_score). Default US,GB,AU.
AD_LIBRARY_MARKETS=
# Apify API token. Only needed for scripts/refresh.py (the weekly Ads Library re-check). Query/ingest/audit need nothing.
APIFY_TOKEN=
# Optional: extra scrape files for raw_scan.py, globs separated by ":" (e.g. ./video-ad-swipe-page-output/*/*/raw_ads.json).
AD_LIBRARY_EXTRA_SCRAPES=
# Optional: shell command refresh.py runs after a PASSING audit (your own sync/export step).
AD_LIBRARY_POST_CMD=
# Optional: base URL if you serve the media folder from a static host (used by lib_ids.media_url and audit --http).
AD_LIBRARY_MEDIA_BASE=
# Optional: Slack bot token (chat:write scope) for refresh.py --slack one-line summaries.
SLACK_BOT_TOKEN=
# Optional: Slack channel id for those summaries.
SLACK_CHANNEL_ID=
