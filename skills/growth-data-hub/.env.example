# growth-data-hub secrets. Copy to .env (same folder) and fill in what you have; every source is optional.
# Never commit .env. SETUP.md says exactly where each value comes from.
# Put comments on their own line, never after a value.

# Meta: system user token with ads_read (Business Settings > Users > System users > Generate new token)
META_ACCESS_TOKEN=

# Google Ads: developer token (manager account > Admin > API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=
# Google Ads: OAuth client, type Desktop app (Google Cloud > APIs & Services > Credentials)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Google Ads: refresh token, printed by: .venv/bin/python tools/google_oauth.py
GOOGLE_ADS_REFRESH_TOKEN=
# Google Ads: only if access comes through a manager (MCC) account: the manager's 10-digit id. Otherwise leave empty.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# GA4: path to the service account JSON key file (its email needs Viewer on the GA4 property)
GA4_SERVICE_ACCOUNT_JSON=

# Microsoft Clarity: Settings > Data Export > Generate new API token (project admins only)
CLARITY_API_TOKEN=

# GoHighLevel: sub-account Settings > Private Integrations > Create new integration
GHL_PRIVATE_TOKEN=
