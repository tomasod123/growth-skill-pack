# Meta Marketing API token (read-only system user, scope ads_read). Live data mode only.
META_ACCESS_TOKEN=
# Ad account id, digits or act_XXXXXXXXXX. Live data mode only (or pass --account).
META_AD_ACCOUNT_ID=
# Optional: Graph API version, e.g. v22.0. Empty = v21.0. Set it when Meta retires the default.
META_GRAPH_VERSION=
# Optional: pin a campaign id; empty = biggest spender in the last 30 days.
META_CAMPAIGN_ID=
# GoHighLevel Private Integration token for the sub-account (read scopes). Live data mode only.
GHL_API_KEY=
# GoHighLevel sub-account (location) id.
GHL_LOCATION_ID=
# Optional: pipeline id to audit; empty = first pipeline (list with ghl_pull.py --list-pipelines).
GHL_PIPELINE_ID=
# Optional: post one summary message to Slack (bot token with chat:write) ...
SLACK_BOT_TOKEN=
# ... into this channel id.
SLACK_CHANNEL_ID=
