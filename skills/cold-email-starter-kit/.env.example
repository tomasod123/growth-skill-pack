# cold-email-starter-kit — add these to ~/.claude/skills/.env (shared by every skill in the pack)

# Dynadot domain registrar API key (domain search + purchase + nameserver switch). Your IP must be whitelisted.
DYNADOT_API_KEY=
# Zapmail API token (connect domains, create and export inboxes)
ZAPMAIL_API_KEY=
# Prospeo API key (lead search / export, spends credits)
PROSPEO_API_KEY=
# Smartlead API key (only if you send with Smartlead)
SMARTLEAD_API_KEY=
# Instantly API v2 key (only if you send with Instantly)
INSTANTLY_API_KEY=

# Optional enrichment, leave blank for a first campaign
# Blitz API key (company phone enrichment)
BLITZ_API_KEY=
# Blitz API base URL, blank = https://api.blitz.us
BLITZ_BASE_URL=
# OpenRouter API key (AI company analysis, gpt-4o-mini by default)
OPENROUTER_API_KEY=
# RapidAPI key (LinkedIn profile scraper + OpenWebNinja news search subscriptions)
RAPIDAPI_KEY=

# Sending identity used when creating Zapmail inboxes
# First name on the sending inboxes, e.g. Jane
SENDER_FIRST_NAME=
# Last name on the sending inboxes, e.g. Doe
SENDER_LAST_NAME=
# Local part of inbox 1 per domain, e.g. jane
SENDER_EMAIL_PREFIX_1=
# Local part of inbox 2 per domain, e.g. janedoe
SENDER_EMAIL_PREFIX_2=
# Where replies should go (optional; usually leave blank and use the platform's master inbox)
DEFAULT_REPLY_TO_EMAIL=

# Physical mailing address for your email footer (CAN-SPAM). Not read by scripts; used when writing copy.
COMPANY_NAME=
COMPANY_STREET=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_ZIP=
COMPANY_COUNTRY=
