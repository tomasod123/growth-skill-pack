# Copy to .env in this folder and fill in. Never commit the real .env.

# Meta system user token with ads_read (SETUP.md, step 1). Optional: without it only CRM checks run.
META_ACCESS_TOKEN=YOUR_META_SYSTEM_USER_TOKEN

# GHL Private Integration Token, one per sub-account (SETUP.md, step 2).
# The name must match ghl.token_env for that business in config.yaml.
GHL_TOKEN=YOUR_GHL_PRIVATE_INTEGRATION_TOKEN
# GHL_TOKEN_SECOND_LOCATION=YOUR_OTHER_PRIVATE_INTEGRATION_TOKEN

# Optional. Only used with --send. Slack incoming webhook URL (SETUP.md, step 4)
SLACK_WEBHOOK_URL=
