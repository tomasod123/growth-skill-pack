# Optional: real stock photos. Without it, picsum.photos placeholders are used.
UNSPLASH_ACCESS_KEY=
# Google Sheets input only (CSV input needs none of these):
# path to the OAuth desktop client JSON downloaded from Google Cloud Console
GOOGLE_OAUTH_CLIENT_FILE=
# path where the login token is saved after the first browser login (e.g. ~/.config/design-website/token.json)
GOOGLE_TOKEN_FILE=
