# GoHighLevel Private Integration token (read-only) for the sub-account the pages feed. Used by `verify` only.
# Sub-account Settings > Private Integrations > Create new Integration, scopes contacts.readonly + locations/customFields.readonly.
GHL_API_KEY=
# Sub-account id: Settings > Business Profile (Location ID), or the id after /location/ in the app URL.
GHL_LOCATION_ID=
# The inbound webhook URL from the workflow's "Inbound Webhook" trigger (Automation > Workflows > trigger > copy URL). Used by `send`.
GHL_WEBHOOK_URL=
# Optional. String every test email contains, matched by the workflow's Real-enquiry branch (default +lptest).
LP_TEST_MARKER=
