# Optional. Only for the read-only calendar check (GET /calendars/{id}). The survey audit and fold check need no key.
# Sub-account Settings > Private Integrations > Create new Integration, scopes calendars.readonly (+ workflows.readonly, locations/customValues.readonly).
GHL_API_KEY=
# Optional. Sub-account id: Settings > Business Profile (Location ID), or the id after /location/ in the app URL.
GHL_LOCATION_ID=
# Optional. White-label link domain that serves your widgets, e.g. https://links.yourdomain.com
GHL_WIDGET_HOST=
# Optional. Comma-separated extra iframe hosts for fold.mjs (your white-label link domain), e.g. links.yourdomain.com
FOLD_IFRAME_HOSTS=
# Optional. Full path to Chrome/Chromium if fold.mjs cannot find it (CHROME_BIN also accepted).
CHROME_PATH=
