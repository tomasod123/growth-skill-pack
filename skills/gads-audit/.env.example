# gads-audit. Copy into ~/.claude/skills/.env. Google Ads vars are shared with gads-common (see its SETUP.md).
# Google Ads developer token: manager account > Tools > API Center (Explorer or Basic access for real accounts).
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth Desktop app client id: Google Cloud Console > APIs & Services > Credentials.
GOOGLE_ADS_CLIENT_ID=
# OAuth Desktop app client secret (same client).
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token from `python3 ~/.claude/skills/gads-common/scripts/gads.py login --save`.
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account id, 10 digits, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional default client account id, 10 digits, no dashes.
GOOGLE_ADS_CUSTOMER_ID=
# DataForSEO API login (your account email) from https://app.dataforseo.com/api-access . Modules 2 and 4.
DATAFORSEO_LOGIN=
# DataForSEO API password from the same page (NOT your dashboard password).
DATAFORSEO_PASSWORD=
# Optional: PageSpeed Insights API key (Cloud Console > APIs & Services > enable "PageSpeed Insights API" > Credentials > API key). Adds field data to module 3.
PSI_API_KEY=
# Optional: name shown in the "who" column and the email greeting (default "PPC manager").
GADS_AUDIT_OWNER=
# Optional: name that signs the draft email.
GADS_AUDIT_SENDER=
# Optional: Chrome/Chromium binary for module 3 (landing_page.py) if not in a standard location. CHROME_BIN is also accepted; --chrome wins.
CHROME_PATH=
# Optional: path to Node 22+ if `node` on PATH is older (module 3 needs the built-in WebSocket).
NODE_BIN=
# Optional, only for build_outputs.py --supabase: your Supabase project URL (Project Settings > API).
SUPABASE_URL=
# Optional, only for --supabase: service_role key (Project Settings > API). Keep secret.
SUPABASE_SERVICE_KEY=
