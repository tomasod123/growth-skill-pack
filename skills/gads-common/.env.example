# gads-common: read-only Google Ads API access. Copy these lines into ~/.claude/skills/.env and fill them in.
# Developer token: Google Ads MANAGER account > Tools (wrench) > Setup > API Center. Needs Explorer or Basic access for real accounts.
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth client id (Desktop app): Google Cloud Console > APIs & Services > Credentials > Create credentials > OAuth client ID.
GOOGLE_ADS_CLIENT_ID=
# OAuth client secret from the same Desktop app client.
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token: run `python3 ~/.claude/skills/gads-common/scripts/gads.py login` once and paste the printed value (or use --save).
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account id, 10 digits, NO dashes. Shown top right in Google Ads when you are in the manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional default client account id to read (10 digits, no dashes).
GOOGLE_ADS_CUSTOMER_ID=
# Optional: API version override if the default has been sunset (e.g. v26).
GOOGLE_ADS_API_VERSION=
